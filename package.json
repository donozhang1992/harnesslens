{
  "name": "intentlink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "extensions/*"
  ],
  "scripts": {
    "test": "npm run test:core && npm run test:hook && npm run test:chrome",
    "test:core": "npm --workspace @intentlink/core run test",
    "test:hook": "npm --workspace @intentlink/git-hook run test",
    "test:chrome": "npm --workspace @intentlink/chrome-extension run test",
    "build": "npm run build:core && npm run build:hook && npm run build:chrome",
    "build:core": "npm --workspace @intentlink/core run build",
    "build:hook": "npm --workspace @intentlink/git-hook run build",
    "build:chrome": "npm --workspace @intentlink/chrome-extension run build",
    "typecheck": "npm run typecheck:core && npm run typecheck:hook && npm run typecheck:chrome",
    "typecheck:core": "npm --workspace @intentlink/core run typecheck",
    "typecheck:hook": "npm --workspace @intentlink/git-hook run typecheck",
    "typecheck:chrome": "npm --workspace @intentlink/chrome-extension run typecheck"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
