{
  "name": "harnesslens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "test": "npm run test:core && npm run test:browser && npm run test:vscode",
    "test:core": "npm --workspace @harnesslens/core run test",
    "test:browser": "npm --workspace @harnesslens/browser-extension run test",
    "test:vscode": "npm --workspace @harnesslens/vscode-extension run test",
    "build": "npm run build:core && npm run build:browser && npm run build:vscode",
    "build:core": "npm --workspace @harnesslens/core run build",
    "build:browser": "npm --workspace @harnesslens/browser-extension run build",
    "build:vscode": "npm --workspace @harnesslens/vscode-extension run build",
    "typecheck": "npm run typecheck:core && npm run typecheck:browser && npm run typecheck:vscode",
    "typecheck:core": "npm --workspace @harnesslens/core run typecheck",
    "typecheck:browser": "npm --workspace @harnesslens/browser-extension run typecheck",
    "typecheck:vscode": "npm --workspace @harnesslens/vscode-extension run typecheck"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
