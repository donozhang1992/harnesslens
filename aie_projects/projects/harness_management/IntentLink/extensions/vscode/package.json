{
  "name": "@harnesslens/vscode-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onView:harnesslens.changedFiles"
  ],
  "contributes": {
    "commands": [
      {
        "command": "harnesslens.refresh",
        "title": "HarnessLens: Refresh Changed Files"
      },
      {
        "command": "harnesslens.openFile",
        "title": "HarnessLens: Open File"
      },
      {
        "command": "harnesslens.openDiff",
        "title": "HarnessLens: Open Diff"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "harnesslens.changedFiles",
          "name": "HarnessLens"
        }
      ]
    }
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@harnesslens/core": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0"
  }
}
